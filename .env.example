PORT=5000
MONGO_URI=mongodb://localhost:27017/electropi_pm
# Required, at least 32 random characters. Generate with: openssl rand -hex 32
# Never commit a real value, and never use a weak default.
JWT_SECRET=generate-a-32-plus-character-random-secret-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Email (Resend — https://resend.com)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=ElectroPi PM <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRES_MINUTES=10

# Seed users (local dev only, never production). At least 12 characters each.
SEED_ADMIN_PASSWORD=choose-a-strong-password-12-plus-chars
SEED_MEMBER_PASSWORD=choose-a-strong-password-12-plus-chars

# Docker Compose MongoDB root credentials (local only)
MONGO_ROOT_USER=electropi_admin
MONGO_ROOT_PASSWORD=choose-a-strong-password
