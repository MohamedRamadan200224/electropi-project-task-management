# ElectroPi Task Management API — environment variables
# Copy this file to .env and fill in real values:  cp .env.example .env
# NEVER commit .env or any real secret, key or password.
# Every value below is a PLACEHOLDER — replace it before running.
# The app fails fast at startup if JWT_SECRET is missing or shorter than
# 32 characters. RESEND_API_KEY must be non-empty or the app cannot boot
# (the email client is built when the server starts).

# Server
PORT=5000
NODE_ENV=development

# MongoDB — local default. For Atlas, use:
# MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<db-name>
MONGO_URI=mongodb://localhost:27017/electropi_pm

# Auth — REQUIRED. Generate a random secret of at least 32 characters:
# openssl rand -hex 32
JWT_SECRET=your-random-jwt-secret-at-least-32-characters-long-change-me
JWT_EXPIRES_IN=7d

# Email (Resend — https://resend.com)
# REQUIRED to boot: any non-empty value lets the server start; a real key
# is only needed for password-reset emails to actually deliver.
RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL=ElectroPi PM <noreply@yourdomain.com>
RESET_TOKEN_EXPIRES_MINUTES=10

# Frontend origin allowed by CORS. The API serves no frontend itself;
# point your client at http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# Seed users (local dev only, never production). At least 12 characters each.
# npm run seed wipes users, projects and tasks, then creates
# admin@electropi.com and member@electropi.com plus 1 project and 3 tasks.
# It refuses to run when NODE_ENV=production.
SEED_ADMIN_PASSWORD=change-me-admin-password-at-least-12-chars
SEED_MEMBER_PASSWORD=change-me-member-password-at-least-12-chars

# Docker Compose MongoDB root credentials (local only).
# Only used by docker-compose.yml; ignored when running the API directly.
MONGO_ROOT_USER=electropi_admin
MONGO_ROOT_PASSWORD=change-me-mongo-root-password
